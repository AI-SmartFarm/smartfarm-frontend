<?xml version="1.0" encoding="utf-8"?>
<!--
    병해충 발생 알림 팝업 (어두운 카드)
    병해충 이름·장치 이름·타이머는 WarningDialogFragment.kt 가 채웁니다.
    tools:text 값은 Design 탭 미리보기 전용입니다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_dark"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 상단 칩 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip_alert"
        android:drawablePadding="4dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="@string/alert_chip"
        android:textColor="@color/red_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:drawableStartCompat="@drawable/ic_warning_small" />

    <!-- 병해충 아이콘 + 빨간 점 -->
    <FrameLayout
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginTop="20dp">

        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_alert">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bug" />
        </FrameLayout>

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_dot_red" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvAlertTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="‘흰가루병’이(가) 발생했습니다." />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/alert_message_line1"
        android:textColor="@color/dialog_text_sub"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvAlertDevice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/green_bright"
        android:textSize="13sp"
        tools:text="‘순환팬(을)’ 가동합니다." />

    <!-- 현재 조치 상태 박스 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_dialog_inner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_air"
            app:tint="@color/green_bright" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvActionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="순환팬 자동 가동 중" />

            <TextView
                android:id="@+id/tvActionTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/dialog_text_sub"
                android:textSize="11sp"
                tools:text="타이머: 60분 연속 가동" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/green_primary"
        android:text="@string/alert_confirm"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_check_circle"
        app:iconGravity="textStart"
        app:iconTint="@color/white" />

    <TextView
        android:id="@+id/btnClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:padding="12dp"
        android:text="@string/alert_close"
        android:textColor="@color/dialog_text_sub"
        android:textSize="13sp" />
</LinearLayout>
