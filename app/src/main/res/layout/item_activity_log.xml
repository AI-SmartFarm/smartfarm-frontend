<?xml version="1.0" encoding="utf-8"?>
<!-- 활동로그 한 줄 (온도 로그, 토양 수분 로그에서 사용)
     [아이콘]  09-10 13:00
               30°C 초과 환기팬 가동                         -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_item_log"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivType"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_water_drop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Text.SmartFarm.Caption"
            tools:text="9-3 10:00" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/Text.SmartFarm.Body"
            tools:text="토양 수분 함유량 기준치 미만, 자동급수 완료" />
    </LinearLayout>
</LinearLayout>
