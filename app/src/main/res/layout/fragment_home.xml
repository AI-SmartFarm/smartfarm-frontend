<?xml version="1.0" encoding="utf-8"?>
<!--
    대시보드 (My Farm)

    ┌──────────────┬──────────────┐
    │ ① 현재온도     │ ② 토양수분     │   → 누르면 온도 로그 / 토양 수분 로그
    ├──────────────┼──────────────┤
    │ ③ 내 작물      │ ④ 작물 선택하기 │   → ③ 누르면 내 작물 확인
    │   확인하기     │   [토마토 ▾]   │   → ④ 드롭다운으로 작물 선택
    └──────────────┴──────────────┘

    카드 4개를 각각 직접 작성했기 때문에 Android Studio의 Design 탭에서도
    실제 앱과 똑같이 보입니다.
    숫자(24°C, 32%)와 막대 길이는 지금은 고정값이고, API 연결 후 코드에서 바꿉니다.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <!-- gravity="center_vertical" : 카드 4개 묶음을 화면 세로 가운데에 배치 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- ================= 1줄 ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- ① 현재온도 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTemperature"
                style="@style/Widget.SmartFarm.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <!-- 아이콘 + 현재온도 + > -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_thermometer" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="@string/home_label_temperature"
                            android:textAppearance="@style/Text.SmartFarm.CardLabel" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTemperatureValue"
                        android:layout_marginTop="20dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_temperature_value"
                        android:textAppearance="@style/Text.SmartFarm.BigValue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/home_temperature_range"
                        android:textAppearance="@style/Text.SmartFarm.Small"
                        android:textColor="@color/green_primary" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressTemperature"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        android:progress="60"
                        app:indicatorColor="@color/green_primary"
                        app:trackColor="@color/green_light"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ② 토양수분 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSoil"
                style="@style/Widget.SmartFarm.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_water_drop" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="@string/home_label_soil"
                            android:textAppearance="@style/Text.SmartFarm.CardLabel" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSoilValue"
                        android:layout_marginTop="20dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_soil_value"
                        android:textAppearance="@style/Text.SmartFarm.BigValue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/home_soil_range"
                        android:textAppearance="@style/Text.SmartFarm.Small"
                        android:textColor="@color/blue_primary" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressSoil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        android:progress="32"
                        app:indicatorColor="@color/blue_primary"
                        app:trackColor="@color/blue_light"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ================= 2줄 ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:orientation="horizontal">

            <!-- ③ 내 작물 확인하기 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCropCheck"
                style="@style/Widget.SmartFarm.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_icon_circle">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sprout" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/home_crop_check_title"
                        android:textAppearance="@style/Text.SmartFarm.CardTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:drawablePadding="2dp"
                        android:gravity="center_vertical"
                        android:text="@string/home_crop_check_link"
                        android:textAppearance="@style/Text.SmartFarm.Small"
                        android:textColor="@color/green_primary"
                        app:drawableEndCompat="@drawable/ic_arrow_forward" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ④ 작물 선택하기 카드 (누르는 카드가 아니라 안의 드롭다운을 누름) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCropSelect"
                style="@style/Widget.SmartFarm.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_icon_circle">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sprout" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/home_crop_select_title"
                        android:textAppearance="@style/Text.SmartFarm.CardTitle" />

                    <!-- 드롭다운: 박스를 누르면 아래로 작물 목록이 펼쳐짐 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutCropDropdown"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/green_primary"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/dropdownCrop"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:paddingVertical="8dp"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            tools:text="토마토" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
