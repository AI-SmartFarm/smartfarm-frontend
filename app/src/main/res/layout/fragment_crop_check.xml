<?xml version="1.0" encoding="utf-8"?>
<!--
    내 작물 확인 화면
    ┌ ① 작물 사진 카드 : 사진 + [다시 촬영 ↻]
    └ ② 병해충 로그 카드 : 날짜별 병해충 감지·조치 기록
    사진·목록은 CropCheckFragment.kt 가 채웁니다.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- ① 작물 사진 카드 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SmartFarm.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 지금은 카메라 아이콘 자리표시. 서버에서 사진을 받으면 여기에 표시 -->
                <ImageView
                    android:id="@+id/ivCropPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/photo_height"
                    android:background="@color/photo_placeholder"
                    android:contentDescription="@string/title_crop_check"
                    android:scaleType="center"
                    android:src="@drawable/ic_camera" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ② 병해충 로그 카드 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SmartFarm.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_list_alt" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/pest_log_title"
                        android:textAppearance="@style/Text.SmartFarm.CardLabel" />

                    <TextView
                        android:id="@+id/tvLogCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Text.SmartFarm.Caption"
                        tools:text="전체 3건 기록" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_pest_log" />

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="20dp"
                    android:text="@string/log_empty"
                    android:textAppearance="@style/Text.SmartFarm.Caption"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
